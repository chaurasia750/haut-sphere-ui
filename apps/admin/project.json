{
  "name": "admin",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/admin/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/admin",
        "index": "apps/admin/src/index.html",
        "baseHref": "/",
        "main": "apps/admin/src/main.ts",
        "tsConfig": "apps/admin/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/admin/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*.json",
            "input": "libs/shared/i18n/assets",
            "output": "assets/i18n"
          },
          "apps/admin/src/public"
        ],
        "styles": [
          "apps/admin/src/tailwind.css",
          "apps/admin/src/styles.scss"
        ],
        "scripts": [],
        "customWebpackConfig": {
          "path": "apps/admin/webpack.config.ts"
        }
      },
      "configurations": {
        "production": {
          "optimization": true,
          "outputHashing": "all",
          "namedChunks": false,
          "aot": true,
          "extractLicenses": true,
          "vendorChunk": false,
          "fileReplacements": [
            {
              "replace": "libs/shared/environments/src/api.dev.ts",
              "with": "libs/shared/environments/src/api.prod.ts"
            }
          ]
        },
        "staging": {
          "optimization": true,
          "outputHashing": "all",
          "namedChunks": false,
          "aot": true,
          "extractLicenses": true,
          "vendorChunk": false,
          "fileReplacements": [
            {
              "replace": "libs/shared/environments/src/api.dev.ts",
              "with": "libs/shared/environments/src/api.staging.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "aot": true,
          "vendorChunk": true,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "admin:build",
        "host": "localhost",
        "port": 4101,
        "hmr": false,
        "liveReload": false,
        "publicHost": "http://localhost:4101"
      },
      "configurations": {
        "production": {
          "buildTarget": "admin:build:production"
        },
        "staging": {
          "buildTarget": "admin:build:staging"
        },
        "development": {
          "buildTarget": "admin:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {}
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "admin:build",
        "port": 4200,
        "staticFilePath": "dist/admin/browser",
        "spa": true
      }
    }
  }
}
