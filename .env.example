# Environment Configuration Example
# Copy this file to .env and update values for your environment

# Remote Entry URLs (Module Federation)
ADMIN_REMOTE_URL=http://localhost:4201/remoteEntry.js
MEMBER_REMOTE_URL=http://localhost:4202/remoteEntry.js
MANAGEMENT_REMOTE_URL=http://localhost:4203/remoteEntry.js

# API Configuration
API_BASE_URL=http://localhost:3000/api
API_TIMEOUT_MS=30000

# Authentication
AUTH_TOKEN_KEY=auth_token
AUTH_USER_KEY=auth_user
AUTH_TOKEN_EXPIRY_MS=3600000

# Observability
SENTRY_DSN=https://key@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Features
ENABLE_ERROR_BOUNDARY=true
ENABLE_SENTRY=false
ENABLE_PERFORMANCE_MONITORING=false

# Development
DEBUG_MODE=false
LOG_LEVEL=info
