# Environment Configuration
# All environment configs are in libs/shared/environments/src/
# Edit those TypeScript files directly to change values.
#
# Available files:
#   api.dev.ts       - Development API config
#   api.staging.ts   - Staging API config
#   api.prod.ts      - Production API config
#   remotes.dev.ts   - Development remote URLs (shell only)
#   remotes.staging.ts - Staging remote URLs (shell only)
#   remotes.prod.ts  - Production remote URLs (shell only)
